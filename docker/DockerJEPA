
FROM nvidia/cuda:12.2.2-cudnn8-devel-ubuntu22.04

RUN echo 'debconf debconf/frontend select Noninteractive' | debconf-set-selections

RUN apt-get update && apt-get install -y software-properties-common \
    && add-apt-repository universe

RUN apt-get update && apt-get install -y \
    git mesa-utils \
    python3.10 python3.10-dev python3.10-distutils python3-pip \
    libegl1-mesa libgl1-mesa-glx libglib2.0-0 libfuse2 \
    wget unzip patchelf \
    libosmesa6-dev libglfw3 libglew-dev gcc g++ \
    && rm -rf /var/lib/apt/lists/*

ENV MUJOCO_GL=egl

COPY requirements.txt /tmp/requirements.txt

# Pin JAX to 0.4.14 so it stays compatible with flax==0.7.2 and numpy==1.23.0
# (unpinned jax[cuda12] pulls a version that needs np.dtypes from NumPy >=1.25).
# MuJoCo / Gymnasium come from OfflineRL-Kit (and requirements.txt); no mujoco-py or d4rl.
RUN python3 -m pip install --upgrade pip setuptools wheel \
    && python3 -m pip install torch torchvision torchaudio --index-url https://download.pytorch.org/whl/cu124 \
    && grep -Ev '^(wandb|dropbox)' /tmp/requirements.txt > /tmp/requirements-core.txt \
    && python3 -m pip install -r /tmp/requirements-core.txt \
    && python3 -m pip install "jax[cuda12_pip]==0.4.14" \
        -f https://storage.googleapis.com/jax-releases/jax_cuda_releases.html \
    && python3 -m pip install --no-deps \
        flax==0.7.2 orbax-checkpoint==0.2.3 optax==0.1.7 chex==0.1.82 \
    && python3 -m pip install numpy==1.23.0 scipy==1.10.1

WORKDIR /workspace



RUN python3 -m pip install --upgrade pip setuptools wheel \
    && python3 -m pip install "gymnasium[mujoco]>=1.0.0" "gymnasium-robotics>=1.3.0" "mujoco>=3.0.0" h5py \
    && python3 -c "import mujoco; import gymnasium; print('mujoco', mujoco.__version__, 'gymnasium', gymnasium.__version__)"

###### Data Collection #######
RUN python3 -m pip install pynput pygame

#####Stable World Model INSTALLATION #########
ARG STABLE_WORLD_MODEL_CACHEBUST
RUN cd /workspace && \
    echo "Stable World Model cache bust: ${STABLE_WORLD_MODEL_CACHEBUST}" && \
    rm -rf stable-worldmodel && \
    git clone --branch LEQ-Dev https://github.com/mohammad200h/stable-worldmodel.git && \
    cd stable-worldmodel && pip install -e .

######LEQ-DreamerV3 INSTALLATION #########
# setup.py expects ./requirements.txt, but the repo only ships dreamerv3/requirements.txt
RUN cd /workspace && \
    echo "LEQ-DreamerV3 cache bust: ${STABLE_WORLD_MODEL_CACHEBUST}" && \
    rm -rf LEQ_DV3 && \
    git clone --branch bringing_it_up_to_data https://github.com/mohammad200h/LEQ_DV3.git && \
    cd LEQ_DV3 && \
    ln -sf dreamerv3/requirements.txt requirements.txt && \
    pip install -e .

###### W&B INSTALLATION #########
# W&B >=0.22.3 accepts modern wandb_v1_ API keys (older SDKs require 40-char keys).
# Install after stable-worldmodel so nothing downgrades them (also avoids a
# typing-extensions conflict with tensorflow_probability during core deps install).
RUN python3 -m pip install --upgrade "wandb>=0.22.3" dropbox \
    && python3 -c "import wandb, dropbox; assert tuple(map(int, wandb.__version__.split('.')[:2])) >= (0, 22), wandb.__version__; print('wandb', wandb.__version__, 'dropbox', dropbox.__version__)"

# Load WANDB_API_KEY from mounted .env on interactive shells
RUN printf '%s\n' \
    'if [ -f /workspace/LEQ/docker/.env ]; then' \
    '  set -a' \
    '  . /workspace/LEQ/docker/.env' \
    '  set +a' \
    'fi' \
    >> /etc/bash.bashrc

CMD ["/bin/bash"]
